{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restack",
  "version": "0.1.0",
  "identifier": "com.jay.restack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Restack",
        "width": 800,
        "height": 600
      }
    ],
     "security": {
    "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost;",
    "assetProtocol": {
      "enable": true,
      "scope": [
        "$HOME/.local/share/com.jay.restack/thumbnails/**"
      ]
    }
  }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/restack-icon.svg",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
